generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String
  descricao String?
  icone     String?
  ativo     Boolean   @default(true)
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id           Int       @id @default(autoincrement())
  nome         String
  descricao    String?
  marca        String?
  codigoBarras String?   @unique @map("codigo_barras")
  imagemUrl    String?   @map("imagem_url")
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  pesoVolume   String?   @map("peso_volume")
  tipo         String?   @default("industrializado")
  categoriaId  Int?      @map("categoria_id")
  categoria    Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("produtos")
}
